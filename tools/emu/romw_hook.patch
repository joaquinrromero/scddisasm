+#include <unistd.h>
+static void romw(const char *t, unsigned int a, unsigned int d)
+{
+  static const char hx[] = "0123456789ABCDEF";
+  char buf[48]; int i = 0, k;
+  if (a >= 0x400000) return;
+  buf[i++]='R';buf[i++]='O';buf[i++]='M';buf[i++]='W';buf[i++]=' ';buf[i++]=t[0];buf[i++]=' ';
+  for (k = 20; k >= 0; k -= 4) buf[i++] = hx[(a >> k) & 15];
+  buf[i++]=' ';
+  for (k = 12; k >= 0; k -= 4) buf[i++] = hx[(d >> k) & 15];
+  buf[i++]=' ';buf[i++]='p';buf[i++]='c';buf[i++]='=';
+  { unsigned int pc = m68k.pc; for (k = 20; k >= 0; k -= 4) buf[i++] = hx[(pc >> k) & 15]; }
+  buf[i++]='\n';
+  write(2, buf, i);
+}
+
 void m68k_unused_8_w(unsigned int address, unsigned int data)
 {
+  romw("b", address, data);
 #ifdef LOGERROR
-  error("Unused write8 %08X = %02X (%08X)\n", address, data, m68k_get_reg(M68K_REG_PC));
+  error("Unused write8 %08X = %02X (%08X)\n", address, data, m68k.pc);
 #endif
 }
 
 void m68k_unused_16_w(unsigned int address, unsigned int data)
 {
+  romw("w", address, data);
 #ifdef LOGERROR
-  error("Unused write16 %08X = %04X (%08X)\n", address, data, m68k_get_reg(M68K_REG_PC));
+  error("Unused write16 %08X = %04X (%08X)\n", address, data, m68k.pc);
 #endif
 }
 
